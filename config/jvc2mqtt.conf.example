# jvc2mqtt – JVC KD-SX38MBT car receiver ↔ Home Assistant
# Live copy: /etc/jvc2mqtt/jvc2mqtt.conf. A first install run from a terminal
# asks for the important values; ask again any time with
#     sudo jvc2mqtt-install --configure
# or edit it by hand and re-run  sudo jvc2mqtt-install
#
# Lines are plain shell assignments: KEY="value"  (no spaces around '=')
#
# The radio's clock is set from this computer's local time on every connect,
# so its time zone must be right (timedatectl; on the Odroid, TIMEZONE in
# /etc/odroid-ha/odroid-ha.conf).

# ─── The radio (Bluetooth Classic / SPP) ────────────────────────────────────
# The radio's Bluetooth address (bluetoothctl devices).
JVC_MAC=""
# RFCOMM channel of the JVC Remote (SPP) service. Found with jvc-probe.py scan/listen.
JVC_CHANNEL="16"
# Bluetooth adapter that talks to the radio (ls /sys/class/bluetooth). Any Linux
# box with Bluetooth in range of the radio works; it doesn't have to be an Odroid.
BT_ADAPTER="hci0"

# ─── Radio audio (Music Assistant player through the radio) ─────────────────
# Squeezelite → BlueALSA → Bluetooth (A2DP) → the radio. Music Assistant finds
# the player once its "Squeezelite (slimproto)" provider is added. Doesn't get
# along with a BLE proxy on the same dongle (its scanning blocks connecting).
ENABLE_RADIO_AUDIO="1"
# Player name in Music Assistant (no spaces)
RADIO_AUDIO_NAME="Car-Radio"
# Music Assistant host, only if auto-discovery doesn't find it. Empty = auto.
RADIO_AUDIO_SERVER=""
# How often to try reconnecting the radio's audio while it's off (seconds)
RADIO_RECONNECT_SECONDS="15"
# Squeezelite buffers, for skips at the start of playback. SQUEEZELITE_BUFFER
# is -b <stream KB>:<output KB> (Squeezelite's default 2048:3446);
# SQUEEZELITE_ALSA is -a <buffer ms>:<periods> for the BlueALSA output
# (Squeezelite's default 40:4). Empty = Squeezelite's default.
SQUEEZELITE_BUFFER="4096:8192"
SQUEEZELITE_ALSA="200:4"
# Squeezelite's player MAC, which is also Music Assistant's player ID. Pin it
# (e.g. "70:f1:1c:18:57:7c") so the player keeps its ID and settings if the
# radio moves to another host. Empty = this host's network address.
SQUEEZELITE_MAC=""
# What the radio's display shows while Music Assistant is stopped. The radio
# shows STOP for "stopped"; "paused" or "playing" with RADIO_IDLE_TEXT show that
# text as the track title instead. (With "playing" the radio's play button still
# starts playback: its Pause press is sent to HA as play.)
RADIO_IDLE_STATUS="paused"
RADIO_IDLE_TEXT="Music Assistant"
# The radio's display (play state, track) and its play/pause/next/previous
# buttons follow this Home Assistant media_player. Needs a long-lived access
# token, which --configure asks for and keeps in /etc/jvc2mqtt/ha-token
# (never in this file). Empty = media_player.<RADIO_AUDIO_NAME, lowercased,
# dashes as underscores>, e.g. media_player.car_radio.
RADIO_HA_ENTITY=""

# ─── jvc2mqtt bridge (radio settings as Home Assistant entities, MQTT) ──────
# Holds the radio's remote link, so the JVC Remote phone app can't connect
# while it runs; switch.<RADIO_ENTITY_PREFIX>_remote_link off lets the app in.
ENABLE_BRIDGE="0"
# MQTT broker (the Mosquitto app on Home Assistant). Empty = the host in HA_API_URL, else homeassistant.local
MQTT_HOST=""
MQTT_PORT="1883"
# The password is asked by --configure and kept in /etc/jvc2mqtt/mqtt-password
# (mode 600), never in this file.
MQTT_USER=""
# Entity IDs are <domain>.<RADIO_ENTITY_PREFIX>_<setting>, e.g. number.car_radio_volume
RADIO_ENTITY_PREFIX="car_radio"
# Topic prefixes
MQTT_PREFIX="jvc2mqtt"
HA_DISCOVERY_PREFIX="homeassistant"

# ─── Home Assistant ─────────────────────────────────────────────────────────
# Home Assistant's address for the API, e.g. "http://192.168.1.3:8123".
# Empty = http://homeassistant.local:8123
HA_API_URL=""
